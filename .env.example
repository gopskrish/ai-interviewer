# Interviewer service settings. Copy to .env and fill in ATTENDEE_API_KEY.
DATA_DIR=/data
KITS_DIR=/app/kits
MODELS_DIR=/models

# local = free models on this PC. openai is not built yet.
AI_MODE=local

OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b-instruct
LLM_TIMEOUT_S=20

WHISPER_MODEL=small
WHISPER_CPU_THREADS=4

# kokoro (better voice) or piper (faster on slow PCs)
TTS_ENGINE=kokoro
KOKORO_MODEL=/models/kokoro/kokoro-v1.0.int8.onnx
KOKORO_VOICES=/models/kokoro/voices-v1.0.bin
KOKORO_VOICE=af_heart
PIPER_VOICE=/models/piper/en_US-lessac-medium.onnx

ATTENDEE_BASE_URL=http://attendee-app:8000
# Create this in the Attendee UI at http://localhost:8000 (API Keys section).
ATTENDEE_API_KEY=
PUBLIC_WS_BASE=wss://interviewer:8443

# Optional: a Teams channel webhook URL (Workflows) to post scorecards to.
TEAMS_WEBHOOK_URL=
RETENTION_DAYS=30
BOT_NAME=AI Interviewer
END_OF_TURN_SILENCE_S=1.5
